NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

ANTHROPIC_API_KEY=your_anthropic_key

GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Shared secret that unlocks write/edit/delete + AI/Places routes.
# Without it those routes fail closed (503). Friends never need it — only the
# curator enters it once (stored in their browser's localStorage).
ADMIN_SECRET=pick_a_long_random_string

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram
